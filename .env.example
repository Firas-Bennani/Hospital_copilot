# ─── Hospital Copilot — configuration (copier en .env) ────────────────────────
LOG_LEVEL=INFO

# Base de données : SQLite par défaut (dashboard/clinic.db). SQL Server :
# DATABASE_URL=mssql+pyodbc://sa:HackCure!2026@localhost:1433/hackcure?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#DATABASE_URL=
SEED_ON_STARTUP=1

# Authentification (JWT en cookie HttpOnly)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
AUTH_REQUIRED=1
# Mot de passe de démo commun aux 6 comptes seedés :
#   pharmacien / receptionniste / infirmier / medecin_garde / medecin / owner
DEMO_PASSWORD=hackcure2026

# LLM : mock (hors-ligne) ou anthropic
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
#ANTHROPIC_API_KEY=sk-ant-...
LLM_TIMEOUT_S=20

# MQTT (optionnel : si le broker ne répond pas, tout passe par POST /api/ingest)
MQTT_ENABLED=1
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PREFIX=hackcure

# Telegram (désactivé si vide)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Simulateur embarqué dans le serveur (appareils de toutes les chambres + chambres virtuelles 102-104)
EMBEDDED_SIM=1
SIM_SPEED=1.0

# Agents
AGENTS_ENABLED=1
FOLLOWUP_RECHECK_S=120
ESCALATION_CRITICAL_S=120
ESCALATION_HIGH_S=600
ESCALATION_MEDIUM_S=1800

# Edge (Raspberry Pi) — utilisé par edge/main.py
EDGE_SERVER_URL=http://localhost:8000
EDGE_ROOM=101
