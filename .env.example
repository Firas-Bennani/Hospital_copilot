# ─── Hospital Copilot — configuration (copier en .env) ────────────────────────
LOG_LEVEL=INFO

# Base de données : SQLite par défaut (dashboard/clinic.db). SQL Server :
# DATABASE_URL=mssql+pyodbc://sa:HackCure!2026@localhost:1433/hackcure?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#DATABASE_URL=
SEED_ON_STARTUP=1

# Authentification (JWT en cookie HttpOnly)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
AUTH_REQUIRED=1
# Mot de passe de démo commun aux 6 comptes seedés :
#   pharmacien / receptionniste / infirmier / medecin_garde / medecin / owner
DEMO_PASSWORD=hackcure2026

# LLM réel par défaut (API Anthropic). Sans clé, ou si l'appel échoue, la plateforme bascule seule sur la
# « réponse de secours (LLM indisponible) » ; LLM_PROVIDER=mock force le mode hors-ligne (tests).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=45

# n8n : orchestration de la réponse aux risques (voir n8n/README.md). Si n8n est arrêté, repli sur les agents locaux.
N8N_ENABLED=true
N8N_BASE_URL=http://localhost:5678
# Secret partagé, envoyé dans l'en-tête X-Hospital-Secret de chaque webhook (valeur longue et aléatoire)
N8N_WEBHOOK_SECRET=
# URL de la plateforme vue depuis n8n, et jeton de service (rôle owner) que n8n présente en « Authorization: Bearer … »
PLATFORM_URL=http://localhost:8000
PLATFORM_SERVICE_TOKEN=
# Clé de l'API publique de n8n (Settings → n8n API) : utilisée seulement par n8n/import.ps1 / import.sh
N8N_API_KEY=

# MQTT (optionnel : si le broker ne répond pas, tout passe par POST /api/ingest)
MQTT_ENABLED=1
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PREFIX=hackcure

# Telegram (désactivé si vide)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Simulateur embarqué dans le serveur (appareils de toutes les chambres + chambres virtuelles 102-104)
EMBEDDED_SIM=1
SIM_SPEED=1.0

# Agents
AGENTS_ENABLED=1
FOLLOWUP_RECHECK_S=120
ESCALATION_CRITICAL_S=120
ESCALATION_HIGH_S=600
ESCALATION_MEDIUM_S=1800

# Edge (Raspberry Pi) — utilisé par edge/main.py
EDGE_SERVER_URL=http://localhost:8000
EDGE_ROOM=101
